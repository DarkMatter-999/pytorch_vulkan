#!/usr/bin/env python3
"""Compiler-only PATH adapter; loader isolation never reaches the caller."""
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from shader_toolchain import compiler_main

try:
    raise SystemExit(compiler_main())
except (OSError, ValueError) as error:
    raise SystemExit(f"shader toolchain: {error}")
