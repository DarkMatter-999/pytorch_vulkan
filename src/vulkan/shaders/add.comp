#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0, std430) readonly buffer Lhs { float lhs[]; };
layout(set = 0, binding = 1, std430) readonly buffer Rhs { float rhs[]; };
layout(set = 0, binding = 2, std430) writeonly buffer Out { float out_data[]; };
layout(push_constant) uniform Count { uint element_count; };
void main() {
  uint index = gl_GlobalInvocationID.x;
  if (index < element_count) {
    out_data[index] = lhs[index] + rhs[index];
  }
}
