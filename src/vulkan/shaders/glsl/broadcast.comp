#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0, std430) readonly buffer Input { float input_data[]; };
layout(set = 0, binding = 1, std430) writeonly buffer Output { float output_data[]; };
layout(push_constant, std430) uniform Params {
  uint rank;
  uint output_numel;
  float scale;
  uint input_sizes[8];
  uint output_sizes[8];
} params;
void main() {
  uint output_index = gl_GlobalInvocationID.x;
  if (output_index >= params.output_numel) return;
  uint remainder = output_index;
  uint input_index = 0u;
  for (int d = int(params.rank) - 1; d >= 0; --d) {
    uint dim = uint(d);
    uint coordinate = remainder % params.output_sizes[dim];
    remainder /= params.output_sizes[dim];
    if (params.input_sizes[dim] != 1u) {
      uint stride = 1u;
      for (uint j = dim + 1u; j < params.rank; ++j) stride *= params.input_sizes[j];
      input_index += coordinate * stride;
    }
  }
  output_data[output_index] = input_data[input_index] * params.scale;
}
