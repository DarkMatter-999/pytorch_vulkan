#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0, std430) readonly buffer Input { uint input_data[]; };
layout(set = 0, binding = 1, std430) writeonly buffer Output { uint output_data[]; };
layout(set = 0, binding = 2, std430) readonly buffer Metadata {
  uint input_sizes[8];
  uint output_sizes[8];
  uint sizes[8];
  uint strides[8];
  uint storage_offset;
} metadata;
layout(push_constant, std430) uniform Params {
  uint rank;
  uint output_numel;
  float scale;
}
params;
void main() {
  uint output_index = gl_GlobalInvocationID.x;
  if (output_index >= params.output_numel)
    return;
  uint remainder = output_index;
  uint input_index = metadata.storage_offset;
  for (int d = int(params.rank) - 1; d >= 0; --d) {
    uint dim = uint(d);
    uint coordinate = remainder % metadata.output_sizes[dim];
    remainder /= metadata.output_sizes[dim];
    if (metadata.input_sizes[dim] != 1u) {
      input_index += coordinate * metadata.strides[dim];
    }
  }
  uint input_bits = input_data[input_index];
  if (params.scale == 1.0) {
    output_data[output_index] = input_bits;
  } else {
    float scaled = uintBitsToFloat(input_bits) * params.scale;
    output_data[output_index] = floatBitsToUint(scaled);
  }
}
