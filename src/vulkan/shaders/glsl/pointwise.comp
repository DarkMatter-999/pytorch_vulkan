#version 450

#ifdef POINTWISE_BOOL
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#endif
#ifdef POINTWISE_BOOL_OUTPUT
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#endif

layout(local_size_x = 256) in;

#ifndef POINTWISE_MODE
#define POINTWISE_MODE 0
#endif

#if POINTWISE_MODE == 4 || POINTWISE_MODE == 5
layout(set = 0, binding = 0, std430) readonly buffer Self { float self[]; };
layout(set = 0, binding = 1, std430) readonly buffer Tensor1 { float tensor1[]; };
layout(set = 0, binding = 2, std430) readonly buffer Tensor2 { float tensor2[]; };
#elif POINTWISE_MODE == 0
#ifdef POINTWISE_BOOL
layout(set = 0, binding = 0, std430) readonly buffer Lhs { uint8_t lhs[]; };
layout(set = 0, binding = 1, std430) readonly buffer Rhs { uint8_t rhs[]; };
#else
layout(set = 0, binding = 0, std430) readonly buffer Lhs { float lhs[]; };
layout(set = 0, binding = 1, std430) readonly buffer Rhs { float rhs[]; };
#endif
#elif POINTWISE_MODE == 1
layout(set = 0, binding = 0, std430) readonly buffer Lhs { float lhs[]; };
#elif POINTWISE_MODE == 2
layout(set = 0, binding = 0, std430) readonly buffer Rhs { float rhs[]; };
#elif POINTWISE_MODE == 3
layout(set = 0, binding = 0, std430) readonly buffer Input { float input_data[]; };
#else
#error Unsupported pointwise mode
#endif

#if POINTWISE_MODE == 4 || POINTWISE_MODE == 5
layout(set = 0, binding = 3, std430) writeonly buffer Out { float out_data[]; };
#elif defined(POINTWISE_BOOL) || defined(POINTWISE_BOOL_OUTPUT)
layout(set = 0, binding = 2, std430) writeonly buffer Out { uint8_t out_data[]; };
#else
layout(set = 0, binding = 2, std430) writeonly buffer Out { float out_data[]; };
#endif

struct TensorMetadata {
  uint rank;
  uint sizes[8];
  uint strides[8];
  uint storage_offset;
  uint padding[2];
};

#if POINTWISE_MODE == 4 || POINTWISE_MODE == 5
layout(set = 0, binding = 4, std430) readonly buffer Metadata { uint values[]; } metadata;
#else
layout(set = 0, binding = 3, std430) readonly buffer Metadata { uint values[]; } metadata;
#endif

layout(push_constant) uniform Params {
  float scalar;
  uint element_count;
  uint operation;
  float alpha;
}
params;

const uint NEG = 3u;
const uint ABS = 4u;
const uint RELU = 5u;
const uint ABS_BACKWARD = 6u;
const uint RELU_BACKWARD = 7u;
const uint NE_SCALAR = 8u;
const uint ISFINITE = 9u;
const uint SIGMOID = 15u;
const uint TANH = 16u;
const uint GELU_TANH = 17u;
const uint SIGMOID_BACKWARD = 18u;
const uint TANH_BACKWARD = 19u;
const uint GELU_TANH_BACKWARD = 20u;

// Correctly rounded binary32 rhs * alpha + lhs without optional Float64/Int64
// capabilities or a driver-dependent GLSL Fma implementation. Every finite
// binary32 is an integer significand times a power of two. In units of 2^-298,
// the exact product and addend fit in 18 uint32 words (highest product bit 553).
// Integer operations retain all cancellation and tie-breaking bits, including
// subnormals. Round once, to nearest/even, by constructing the output bits.
void insert_word(inout uint words[18], uint value, uint shift) {
  uint index = shift / 32u;
  uint offset = shift % 32u;
  words[index] |= value << offset;
  if (offset != 0u)
    words[index + 1u] |= value >> (32u - offset);
}

float alpha_add(float lhs_value, float rhs_value, float alpha) {
  uint a = floatBitsToUint(rhs_value);
  uint b = floatBitsToUint(alpha);
  uint c = floatBitsToUint(lhs_value);
  uint ae = (a >> 23u) & 255u;
  uint be = (b >> 23u) & 255u;
  uint ce = (c >> 23u) & 255u;
  // Classify nonfinite operands without first overflowing a finite product.
  // An infinite addend stays infinite for finite multiplicands, even if their
  // exact product exceeds binary32 range; rounding it first could give NaN.
  if (ae == 255u && (a & 0x7fffffu) != 0u)
    return uintBitsToFloat(a | 0x400000u);
  if (be == 255u && (b & 0x7fffffu) != 0u)
    return uintBitsToFloat(b | 0x400000u);
  if (ce == 255u && (c & 0x7fffffu) != 0u)
    return uintBitsToFloat(c | 0x400000u);
  if (ae == 255u || be == 255u) {
    uint infinity = ((a ^ b) & 0x80000000u) | 0x7f800000u;
    if ((a & 0x7fffffffu) == 0u || (b & 0x7fffffffu) == 0u ||
        (ce == 255u && c != infinity))
      return uintBitsToFloat(0x7fc00000u);
    return uintBitsToFloat(infinity);
  }
  if (ce == 255u)
    return lhs_value;
  uint asig = (a & 0x7fffffu) | (ae == 0u ? 0u : 0x800000u);
  uint bsig = (b & 0x7fffffu) | (be == 0u ? 0u : 0x800000u);
  uint csig = (c & 0x7fffffu) | (ce == 0u ? 0u : 0x800000u);
  uint product[18];
  uint addend[18];
  for (int i = 0; i < 18; ++i) {
    product[i] = 0u;
    addend[i] = 0u;
  }
  uint hi, lo;
  umulExtended(asig, bsig, hi, lo);
  uint product_shift = max(ae, 1u) + max(be, 1u) - 2u;
  insert_word(product, lo, product_shift);
  insert_word(product, hi, product_shift + 32u);
  insert_word(addend, csig, max(ce, 1u) + 148u);
  uint product_sign = (a ^ b) & 0x80000000u;
  uint addend_sign = c & 0x80000000u;
  bool product_larger = false;
  for (int i = 17; i >= 0; --i) {
    if (product[i] != addend[i]) {
      product_larger = product[i] > addend[i];
      break;
    }
  }
  uint sign = product_sign == addend_sign || product_larger
      ? product_sign : addend_sign;
  uint carry = 0u;
  for (int i = 0; i < 18; ++i) {
    if (product_sign == addend_sign) {
      uint sum = product[i] + addend[i];
      uint next_carry = uint(sum < product[i]);
      uint result = sum + carry;
      next_carry |= uint(result < sum);
      product[i] = result;
      carry = next_carry;
    } else {
      uint larger = product_larger ? product[i] : addend[i];
      uint smaller = product_larger ? addend[i] : product[i];
      uint difference = larger - smaller;
      uint next_borrow = uint(larger < smaller);
      product[i] = difference - carry;
      next_borrow |= uint(difference < carry);
      carry = next_borrow;
    }
  }
  int top = -1;
  for (int i = 17; i >= 0; --i) {
    if (product[i] != 0u) {
      top = i * 32 + findMSB(product[i]);
      break;
    }
  }
  if (top < 0)
    return uintBitsToFloat(product_sign == addend_sign ? sign : 0u);
  uint shift = uint(max(top - 23, 149));
  uint word = shift / 32u;
  uint offset = shift % 32u;
  uint significand = product[word] >> offset;
  if (offset != 0u && word + 1u < 18u)
    significand |= product[word + 1u] << (32u - offset);
  uint guard_index = (shift - 1u) / 32u;
  uint guard_offset = (shift - 1u) % 32u;
  bool guard = ((product[guard_index] >> guard_offset) & 1u) != 0u;
  bool sticky = (product[guard_index] & ((1u << guard_offset) - 1u)) != 0u;
  for (uint i = 0u; i < guard_index; ++i)
    sticky = sticky || product[i] != 0u;
  if (guard && (sticky || (significand & 1u) != 0u))
    ++significand;
  if (significand >= 0x1000000u) {
    significand >>= 1u;
    ++shift;
  }
  if (significand < 0x800000u)
    return uintBitsToFloat(sign | significand);
  uint exponent = shift - 148u;
  if (exponent >= 255u)
    return uintBitsToFloat(sign | 0x7f800000u);
  return uintBitsToFloat(sign | (exponent << 23u) | (significand & 0x7fffffu));
}

float apply_operation(float lhs_value, float rhs_value) {
  if (params.operation == 0u)
    return alpha_add(lhs_value, rhs_value, params.alpha);
  if (params.operation == 1u)
    return lhs_value - rhs_value;
  if (params.operation == 2u)
    return lhs_value * rhs_value;
  if (params.operation == 12u)
    return lhs_value + params.scalar * (rhs_value - lhs_value);
  if (params.operation == 14u)
    return lhs_value / rhs_value;
  return 0.0;
}

float apply_unary(float value) {
  if (params.operation == NEG)
    return -value;
  if (params.operation == ABS)
    return abs(value);
  if (params.operation == RELU)
    return max(value, 0.0);
  if (params.operation == ABS_BACKWARD) {
    return value > 0.0 ? 1.0 : (value < 0.0 ? -1.0 : 0.0);
  }
  if (params.operation == RELU_BACKWARD)
    return value > 0.0 ? 1.0 : 0.0;
  if (params.operation == 10u)
    return ceil(value);
  if (params.operation == 13u)
    return sqrt(value);
  if (params.operation == SIGMOID)
    return 1.0 / (1.0 + exp(-value));
  if (params.operation == TANH)
    return 2.0 / (1.0 + exp(-2.0 * value)) - 1.0;
  if (params.operation == GELU_TANH) {
    const float inner = 0.7978845608028654 *
        (value + 0.044715 * value * value * value);
    return 0.5 * value * (1.0 +
        (2.0 / (1.0 + exp(-2.0 * inner)) - 1.0));
  }
  if (params.operation == SIGMOID_BACKWARD)
    return value * (1.0 - value);
  if (params.operation == TANH_BACKWARD)
    return 1.0 - value * value;
  if (params.operation == GELU_TANH_BACKWARD) {
    const float value_squared = value * value;
    const float inner = 0.7978845608028654 *
        (value + 0.044715 * value * value_squared);
    const float inner_tanh = 2.0 / (1.0 + exp(-2.0 * inner)) - 1.0;
    return 0.5 * (1.0 + inner_tanh) +
        0.5 * value * (1.0 - inner_tanh * inner_tanh) *
        0.7978845608028654 * (1.0 + 3.0 * 0.044715 * value_squared);
  }
  if (params.operation == 11u)
    return params.scalar;
  return 0.0;
}

uint logical_offset(uint base, uint linear_index) {
  uint offset = metadata.values[base + 17u];
  uint rank = metadata.values[base];
  for (int dimension = int(rank) - 1; dimension >= 0; --dimension) {
    uint coordinate = linear_index % metadata.values[base + 1u + uint(dimension)];
    linear_index /= metadata.values[base + 1u + uint(dimension)];
    offset += coordinate * metadata.values[base + 9u + uint(dimension)];
  }
  return offset;
}

void main() {
  uint index = gl_GlobalInvocationID.x;
  if (index >= params.element_count)
    return;
#if POINTWISE_MODE == 4 || POINTWISE_MODE == 5
  uint self_offset = logical_offset(0u, index);
  uint tensor1_offset = logical_offset(20u, index);
  uint tensor2_offset = logical_offset(40u, index);
  uint output_offset = logical_offset(60u, index);
#if POINTWISE_MODE == 4
  out_data[output_offset] = self[self_offset] + params.scalar *
      (tensor1[tensor1_offset] * tensor2[tensor2_offset]);
#else
  out_data[output_offset] = self[self_offset] + params.scalar *
      (tensor1[tensor1_offset] / tensor2[tensor2_offset]);
#endif
#elif POINTWISE_MODE == 0
  uint lhs_offset = logical_offset(0u, index);
  uint rhs_offset = logical_offset(20u, index);
  uint output_offset = logical_offset(40u, index);
#ifdef POINTWISE_BOOL
  if (params.operation == 0u)
    out_data[output_offset] = uint8_t((lhs[lhs_offset] != 0) || (rhs[rhs_offset] != 0));
  else if (params.operation == 2u)
    out_data[output_offset] = uint8_t((lhs[lhs_offset] != 0) && (rhs[rhs_offset] != 0));
#elif defined(POINTWISE_BOOL_OUTPUT)
   out_data[output_offset] = uint8_t(uint(params.operation == 10u ? lhs[lhs_offset] != rhs[rhs_offset]
                                                                  : lhs[lhs_offset] == rhs[rhs_offset]));
#else
  float rhs_value = rhs[rhs_offset];
  if (params.operation == 0u) {
    out_data[output_offset] = alpha_add(lhs[lhs_offset], rhs_value, params.scalar);
  } else {
    if (params.operation == 1u)
      rhs_value *= params.scalar;
    out_data[output_offset] = apply_operation(lhs[lhs_offset], rhs_value);
  }
#endif
#elif POINTWISE_MODE == 1
  uint input_offset = logical_offset(0u, index);
  uint output_offset = logical_offset(40u, index);
#ifdef POINTWISE_BOOL_OUTPUT
  out_data[output_offset] = uint8_t(lhs[input_offset] != params.scalar);
#else
  if (params.operation == 0u) {
    out_data[output_offset] = alpha_add(lhs[input_offset], params.scalar, params.alpha);
  }
  else
    out_data[output_offset] = apply_operation(lhs[input_offset], params.scalar);
#endif
#elif POINTWISE_MODE == 2
  uint input_offset = logical_offset(20u, index);
  uint output_offset = logical_offset(40u, index);
  if (params.operation == 0u)
    out_data[output_offset] = alpha_add(params.scalar, rhs[input_offset], params.alpha);
  else
    out_data[output_offset] = apply_operation(params.scalar, rhs[input_offset]);
#else
  uint input_offset = logical_offset(0u, index);
  uint output_offset = logical_offset(40u, index);
#ifdef POINTWISE_BOOL_OUTPUT
  out_data[output_offset] = uint8_t(
      uint(input_data[input_offset] == input_data[input_offset] && abs(input_data[input_offset]) <= 3.402823466e+38));
#else
  out_data[output_offset] = apply_unary(input_data[input_offset]);
#endif
#endif
}
