#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer Input { float input_values[]; };
layout(set = 0, binding = 1) writeonly buffer Output { float output_values[]; };
struct TensorMetadata { uint rank; uint sizes[8]; uint strides[8]; uint storage_offset; uint padding[2]; };
layout(set = 0, binding = 2, std430) readonly buffer Metadata { TensorMetadata tensors[2]; } metadata;
layout(push_constant) uniform Params {
  uint operation;
  uint batch;
  uint channels;
  uint in_h;
  uint in_w;
  uint out_h;
  uint out_w;
  float scale_h;
  float scale_w;
  uint flags;
  uint count;
}
params;
// 2-D interpolation, operations 0-5.  Tensors are addressed through the metadata
// strides, so any strided layout (channels-last, permuted, sliced, stride-0
// expanded) is read and written in place.
//   0 nearest fwd   1 nearest-exact fwd   2 bilinear fwd
//   3 nearest bwd   4 nearest-exact bwd   5 bilinear bwd
// Float contract: every arithmetic expression that decides an index or a weight is
// `precise` (SPIR-V NoContraction) and is a separately rounded add, subtract or
// multiply; there is no division, fma or vector arithmetic.  The scales are computed
// on the host with ATen's own helpers.  tools/verify_interpolation_spv.py proves
// this structurally on the compiled and the embedded SPIR-V.
uint tensor_at(TensorMetadata m, uint n, uint c, uint h, uint w) {
  return m.storage_offset + n * m.strides[0] + c * m.strides[1] + h * m.strides[2] + w * m.strides[3];
}
bool align_corners() { return (params.flags & 1u) != 0u; }

// ---- nearest: ATen nearest_idx (shortcuts for out == in and out == 2 * in) -----
uint nearest_source(uint d, uint size_in, uint size_out, float scale) {
  if (size_out == size_in) return d;
  if (size_out == 2u * size_in) return d >> 1u;
  precise float product = float(d) * scale;
  precise float whole = floor(product);
  return uint(min(whole, float(size_in - 1u)));
}

// ---- nearest-exact: ATen nearest_exact_idx (no shortcuts) ----------------------
uint exact_source(uint d, uint size_in, float scale) {
  precise float centre = float(d) + 0.5;
  precise float product = centre * scale;
  precise float whole = floor(product);
  return uint(min(whole, float(size_in - 1u)));
}

// ---- bilinear: ATen compute_source_index_and_lambda ----------------------------
struct Taps { uint i0; uint i1; float l0; float l1; };
Taps bilinear_taps(uint d, uint size_in, uint size_out, float scale) {
  Taps taps;
  if (size_out == size_in) {
    taps.i0 = d;
    taps.i1 = d;
    taps.l0 = 1.0;
    taps.l1 = 0.0;
    return taps;
  }
  precise float real;
  if (align_corners()) {
    real = scale * float(d);
  } else {
    precise float centre = float(d) + 0.5;
    precise float scaled = scale * centre;
    precise float shifted = scaled - 0.5;
    real = max(shifted, 0.0);
  }
  precise float whole = floor(real);
  uint i0 = uint(min(whole, float(size_in - 1u)));
  precise float offset = real - float(i0);
  precise float l1 = min(max(offset, 0.0), 1.0);
  precise float l0 = 1.0 - l1;
  taps.i0 = i0;
  taps.i1 = i0 + (i0 < size_in - 1u ? 1u : 0u);
  taps.l0 = l0;
  taps.l1 = l1;
  return taps;
}

// Primary source index of output coordinate d for mode 0 (nearest), 1 (exact), 2 (bilinear).
uint primary_source(uint mode, uint d, uint size_in, uint size_out, float scale) {
  if (mode == 0u) return nearest_source(d, size_in, size_out, scale);
  if (mode == 1u) return exact_source(d, size_in, scale);
  return bilinear_taps(d, size_in, size_out, scale).i0;
}

// Source indices are non-decreasing in d, so the outputs that reach one input index
// form an interval; this finds the first d in [0, size_out] with source >= target.
uint first_at_least(uint mode, uint target, uint size_in, uint size_out, float scale) {
  uint lo = 0u;
  uint hi = size_out;
  while (lo < hi) {
    uint mid = lo + ((hi - lo) >> 1u);
    if (primary_source(mode, mid, size_in, size_out, scale) >= target) {
      hi = mid;
    } else {
      lo = mid + 1u;
    }
  }
  return lo;
}

// Weight with which output coordinate d feeds input index ih; hit is false when it
// does not (identity dimensions, or an interval-edge candidate).
float tap_weight(uint d, uint ih, uint size_in, uint size_out, float scale, out bool hit) {
  Taps taps = bilinear_taps(d, size_in, size_out, scale);
  precise float weight = 0.0;
  hit = false;
  if (taps.i0 == ih) {
    weight = weight + taps.l0;
    hit = true;
  }
  if (taps.i1 == ih) {
    weight = weight + taps.l1;
    hit = true;
  }
  return weight;
}

void forward(uint mode, uint gid) {
  uint ow = gid % params.out_w;
  uint rest = gid / params.out_w;
  uint oh = rest % params.out_h;
  rest = rest / params.out_h;
  uint c = rest % params.channels;
  uint n = rest / params.channels;
  if (n >= params.batch) return;
  TensorMetadata source = metadata.tensors[0];
  uint destination = tensor_at(metadata.tensors[1], n, c, oh, ow);
  if (mode == 0u) {
    uint ih = nearest_source(oh, params.in_h, params.out_h, params.scale_h);
    uint iw = nearest_source(ow, params.in_w, params.out_w, params.scale_w);
    output_values[destination] = input_values[tensor_at(source, n, c, ih, iw)];
  } else if (mode == 1u) {
    uint ih = exact_source(oh, params.in_h, params.scale_h);
    uint iw = exact_source(ow, params.in_w, params.scale_w);
    output_values[destination] = input_values[tensor_at(source, n, c, ih, iw)];
  } else {
    Taps ty = bilinear_taps(oh, params.in_h, params.out_h, params.scale_h);
    Taps tx = bilinear_taps(ow, params.in_w, params.out_w, params.scale_w);
    float v00 = input_values[tensor_at(source, n, c, ty.i0, tx.i0)];
    float v01 = input_values[tensor_at(source, n, c, ty.i0, tx.i1)];
    float v10 = input_values[tensor_at(source, n, c, ty.i1, tx.i0)];
    float v11 = input_values[tensor_at(source, n, c, ty.i1, tx.i1)];
    precise float top = tx.l0 * v00 + tx.l1 * v01;
    precise float bottom = tx.l0 * v10 + tx.l1 * v11;
    precise float result = ty.l0 * top + ty.l1 * bottom;
    output_values[destination] = result;
  }
}

// One thread per grad_input element (n, c, ih, iw): gather over the output interval
// in ascending (oh, ow) order.  Equals ATen's scatter-add in exact arithmetic.
void backward(uint mode, uint gid) {
  uint iw = gid % params.in_w;
  uint rest = gid / params.in_w;
  uint ih = rest % params.in_h;
  rest = rest / params.in_h;
  uint c = rest % params.channels;
  uint n = rest / params.channels;
  if (n >= params.batch) return;
  TensorMetadata source = metadata.tensors[0];
  uint low_h = mode == 2u ? (ih > 0u ? ih - 1u : 0u) : ih;
  uint low_w = mode == 2u ? (iw > 0u ? iw - 1u : 0u) : iw;
  uint begin_h = first_at_least(mode, low_h, params.in_h, params.out_h, params.scale_h);
  uint end_h = first_at_least(mode, ih + 1u, params.in_h, params.out_h, params.scale_h);
  uint begin_w = first_at_least(mode, low_w, params.in_w, params.out_w, params.scale_w);
  uint end_w = first_at_least(mode, iw + 1u, params.in_w, params.out_w, params.scale_w);
  precise float accumulator = 0.0;
  for (uint oh = begin_h; oh < end_h; ++oh) {
    bool hit_h = true;
    precise float weight_h = 1.0;
    if (mode == 2u) {
      weight_h = tap_weight(oh, ih, params.in_h, params.out_h, params.scale_h, hit_h);
    }
    if (!hit_h) continue;
    for (uint ow = begin_w; ow < end_w; ++ow) {
      bool hit_w = true;
      precise float weight_w = 1.0;
      if (mode == 2u) {
        weight_w = tap_weight(ow, iw, params.in_w, params.out_w, params.scale_w, hit_w);
      }
      if (!hit_w) continue;
      float g = input_values[tensor_at(source, n, c, oh, ow)];
      if (mode == 2u) {
        precise float weight = weight_h * weight_w;
        precise float scaled = g * weight;
        accumulator = accumulator + scaled;
      } else {
        accumulator = accumulator + g;
      }
    }
  }
  output_values[tensor_at(metadata.tensors[1], n, c, ih, iw)] = accumulator;
}

void main() {
  uint gid = gl_GlobalInvocationID.x;
  if (gid >= params.count) return;
  if (params.operation < 3u) {
    forward(params.operation, gid);
  } else {
    backward(params.operation - 3u, gid);
  }
}
