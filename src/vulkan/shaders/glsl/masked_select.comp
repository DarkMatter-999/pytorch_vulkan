#version 450
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
layout(local_size_x = 256) in;
layout(set = 0, binding = 0, std430) readonly buffer Input { float input_data[]; };
layout(set = 0, binding = 1, std430) readonly buffer Mask { uint8_t mask_data[]; };
#ifdef MASKED_SELECT_COUNT
layout(set = 0, binding = 2, std430) buffer Counter { uint counter; };
#else
layout(set = 0, binding = 2, std430) writeonly buffer Output { float output_data[]; };
layout(set = 0, binding = 3, std430) buffer Counter { uint counter; };
#endif
layout(push_constant) uniform Params { uint element_count; }
params;
shared uint selected_per_lane[256];
uint range_start(uint lane) {
  uint quotient = params.element_count / 256u;
  uint remainder = params.element_count % 256u;
  return quotient * lane + min(lane, remainder);
}
uint range_end(uint lane) {
  uint quotient = params.element_count / 256u;
  uint remainder = params.element_count % 256u;
  return quotient * (lane + 1u) + min(lane + 1u, remainder);
}
void main() {
  uint lane = gl_LocalInvocationIndex;
  uint begin = range_start(lane);
  uint end = range_end(lane);
#ifdef MASKED_SELECT_COUNT
  uint selected = 0u;
  for (uint index = begin; index < end; ++index)
    if (mask_data[index] != uint8_t(0))
      ++selected;
  atomicAdd(counter, selected);
#else
  uint selected = 0u;
  for (uint index = begin; index < end; ++index)
    if (mask_data[index] != uint8_t(0))
      ++selected;
  selected_per_lane[lane] = selected;
  barrier();
  uint output_offset = 0u;
  for (uint previous = 0u; previous < lane; ++previous)
    output_offset += selected_per_lane[previous];
  for (uint index = begin; index < end; ++index) {
    if (mask_data[index] != uint8_t(0))
      output_data[output_offset++] = input_data[index];
  }
#endif
}
