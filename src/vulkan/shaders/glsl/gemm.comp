#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer A { float values[]; } a;
layout(set = 0, binding = 1, std430) readonly buffer B { float values[]; } b;
layout(set = 0, binding = 2, std430) readonly buffer C { float values[]; } c;
layout(set = 0, binding = 3, std430) writeonly buffer D { float values[]; } d;
layout(set = 0, binding = 4, std430) readonly buffer Bias { float values[]; } bias;

layout(push_constant, std430) uniform Params {
  /* offset 0 */ uint M;
  /* offset 4 */ uint N;
  /* offset 8 */ uint K;
  /* offset 12 */ uint a_row_stride;
  /* offset 16 */ uint a_col_stride;
  /* offset 20 */ uint b_row_stride;
  /* offset 24 */ uint b_col_stride;
  /* offset 28 */ uint c_row_stride;
  /* offset 32 */ uint c_col_stride;
  /* offset 36 */ uint d_row_stride;
  /* offset 40 */ uint d_col_stride;
  /* offset 44 */ uint bias_stride;
  /* offset 48 */ float alpha;
  /* offset 52 */ float beta;
  /* offset 56 */ uint has_bias;
  /* offset 60 */ uint batch_count;
  /* offset 64 */ uint batch_stride_a;
  /* offset 68 */ uint batch_stride_b;
  /* offset 72 */ uint batch_stride_c;
  /* offset 76 */ uint batch_stride_d;
} params;

shared float tile_a[16][16];
shared float tile_b[16][16];

void main() {
  uint row = gl_WorkGroupID.y * 16u + gl_LocalInvocationID.y;
  uint col = gl_WorkGroupID.x * 16u + gl_LocalInvocationID.x;
  uint batch = gl_WorkGroupID.z;
  float accumulator = 0.0;
  uint tile_count = (params.K + 15u) / 16u;

  for (uint tile = 0u; tile < tile_count; ++tile) {
    uint a_col = tile * 16u + gl_LocalInvocationID.x;
    uint b_row = tile * 16u + gl_LocalInvocationID.y;
    if (row < params.M && a_col < params.K)
      tile_a[gl_LocalInvocationID.y][gl_LocalInvocationID.x] =
          a.values[batch * params.batch_stride_a +
                   row * params.a_row_stride + a_col * params.a_col_stride];
    else
      tile_a[gl_LocalInvocationID.y][gl_LocalInvocationID.x] = 0.0;
    if (b_row < params.K && col < params.N)
      tile_b[gl_LocalInvocationID.y][gl_LocalInvocationID.x] =
          b.values[batch * params.batch_stride_b +
                   b_row * params.b_row_stride + col * params.b_col_stride];
    else
      tile_b[gl_LocalInvocationID.y][gl_LocalInvocationID.x] = 0.0;
    barrier();

    for (uint k = 0u; k < 16u; ++k) {
      uint k_index = tile * 16u + k;
      if (k_index >= params.K)
        break;
      accumulator += tile_a[gl_LocalInvocationID.y][k] * tile_b[k][gl_LocalInvocationID.x];
    }
    barrier();
  }

  if (row < params.M && col < params.N) {
    float value = 0.0;
    if (params.alpha != 0.0)
      value += params.alpha * accumulator;
    if (params.beta != 0.0)
      value += params.beta * c.values[batch * params.batch_stride_c +
                                      row * params.c_row_stride + col * params.c_col_stride];
    if (params.has_bias != 0u)
      value += bias.values[col * params.bias_stride];
    d.values[batch * params.batch_stride_d + row * params.d_row_stride +
             col * params.d_col_stride] = value;
  }
}
