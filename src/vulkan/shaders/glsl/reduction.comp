#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0, std430) readonly buffer Input { float input_data[]; };
layout(set = 0, binding = 1, std430) writeonly buffer Output { float output_data[]; };
layout(push_constant, std430) uniform Params {
  uint rank;
  uint output_numel;
  uint reduce_mask;
  uint reduce_numel;
  uint sizes[8];
  uint strides[8];
  uint storage_offset;
  uint operation;
  uint reduce_dim;
  uint softmax_workgroup;
}
params;

shared float softmax_partial[256];

void main() {
  if (params.operation >= 5u && params.softmax_workgroup != 0u) {
    uint row = gl_WorkGroupID.x;
    uint lane = gl_LocalInvocationID.x;
    if (row >= params.output_numel) return;

    float maximum = -3.402823466e+38;
    for (uint index = lane; index < params.reduce_numel; index += 256u)
      maximum = max(maximum, input_data[params.storage_offset +
                                        row * params.reduce_numel + index]);
    softmax_partial[lane] = maximum;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
      if (lane < stride)
        softmax_partial[lane] = max(softmax_partial[lane],
                                    softmax_partial[lane + stride]);
      barrier();
    }
    maximum = softmax_partial[0];

    float total = 0.0;
    for (uint index = lane; index < params.reduce_numel; index += 256u)
      total += exp(input_data[params.storage_offset +
                              row * params.reduce_numel + index] - maximum);
    softmax_partial[lane] = total;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
      if (lane < stride)
        softmax_partial[lane] += softmax_partial[lane + stride];
      barrier();
    }
    total = softmax_partial[0];

    for (uint index = lane; index < params.reduce_numel; index += 256u) {
      float value = input_data[params.storage_offset +
                              row * params.reduce_numel + index];
      output_data[row * params.reduce_numel + index] = params.operation == 5u
          ? exp(value - maximum) / total
          : value - maximum - log(total);
    }
    return;
  }

  uint output_index = gl_GlobalInvocationID.x;
  if (output_index >= params.output_numel)
    return;
  uint remainder = output_index;
  uint base = params.storage_offset;
  if (params.operation >= 5u) {
    uint coordinate = 0u;
    for (int d = int(params.rank) - 1; d >= 0; --d) {
      uint dim = uint(d);
      uint current = remainder % params.sizes[dim];
      remainder /= params.sizes[dim];
      if (dim == params.reduce_dim) coordinate = current;
      base += current * params.strides[dim];
    }
    base -= coordinate * params.strides[params.reduce_dim];
    float maximum = -3.402823466e+38;
    for (uint index = 0u; index < params.reduce_numel; ++index)
      maximum = max(maximum, input_data[base + index * params.strides[params.reduce_dim]]);
    float total = 0.0;
    for (uint index = 0u; index < params.reduce_numel; ++index)
      total += exp(input_data[base + index * params.strides[params.reduce_dim]] - maximum);
    float value = input_data[base + coordinate * params.strides[params.reduce_dim]];
    output_data[output_index] = params.operation == 5u
        ? exp(value - maximum) / total : value - maximum - log(total);
    return;
  }
  for (int d = int(params.rank) - 1; d >= 0; --d) {
    uint dim = uint(d);
    if ((params.reduce_mask & (1u << dim)) == 0u) {
      uint coordinate = remainder % params.sizes[dim];
      remainder /= params.sizes[dim];
      base += coordinate * params.strides[dim];
    }
  }
  float value = params.operation == 4u ? 1.0 :
                (params.operation == 2u ? -3.402823466e+38 :
                 (params.operation == 3u ? 3.402823466e+38 : 0.0));
  uint reduced = params.reduce_numel;
  for (uint index = 0u; index < reduced; ++index) {
    uint reduced_remainder = index;
    uint input_index = base;
    for (int d = int(params.rank) - 1; d >= 0; --d) {
      uint dim = uint(d);
      if ((params.reduce_mask & (1u << dim)) != 0u) {
        uint coordinate = reduced_remainder % params.sizes[dim];
        reduced_remainder /= params.sizes[dim];
        input_index += coordinate * params.strides[dim];
      }
    }
    float candidate = input_data[input_index];
    if (params.operation == 0u || params.operation == 1u) value += candidate;
    else if (params.operation == 2u) value = max(value, candidate);
    else if (params.operation == 3u) value = min(value, candidate);
    else value *= candidate;
  }
  output_data[output_index] = params.operation == 1u ? value / float(reduced) : value;
}
