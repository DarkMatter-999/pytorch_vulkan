#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer Input { float values[]; };
layout(set = 0, binding = 1) readonly buffer Weight { float weight[]; };
layout(set = 0, binding = 2) readonly buffer Bias { float bias[]; };
layout(set = 0, binding = 3) writeonly buffer Output { float results[]; };
layout(push_constant) uniform Params {
  uint rows;
  uint features;
  uint outputs;
  uint transposed_weight;
  uint has_bias;
  uint operation;
}
params;
void main() {
  uint index = gl_GlobalInvocationID.x;
  uint count = params.rows * params.outputs;
  if (index >= count)
    return;
  uint row = index / params.outputs;
  uint column = index % params.outputs;
  float value = params.has_bias != 0u ? bias[column] : 0.0;
  for (uint i = 0; i < params.features; ++i) {
    if (params.operation == 0u) {
      value += values[row * params.features + i] *
               weight[params.transposed_weight != 0u ? i * params.outputs + column
                                                     : column * params.features + i];
    } else if (params.operation == 1u) {
      value += values[row * params.features + i] * weight[i * params.outputs + column];
    } else {
      value += values[i * params.rows + row] * weight[i * params.outputs + column];
    }
  }
  results[index] = value;
}
