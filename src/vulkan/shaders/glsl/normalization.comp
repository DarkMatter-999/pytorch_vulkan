#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x = 256) in;
layout(set = 0, binding = 0, std430) buffer I0 { float a[]; };
layout(set = 0, binding = 1, std430) buffer I1 { float b[]; };
layout(set = 0, binding = 2, std430) buffer I2 { float c[]; };
layout(set = 0, binding = 3, std430) buffer I3 { float d[]; };
layout(set = 0, binding = 4, std430) buffer I4 { float e[]; };
layout(set = 0, binding = 5, std430) buffer O0 { float f[]; };
layout(set = 0, binding = 6, std430) buffer O1 { float g[]; };
layout(set = 0, binding = 7, std430) buffer O2 { float h[]; };
layout(set = 0, binding = 8, std430) buffer I5 { float i[]; };
layout(set = 0, binding = 9, std430) buffer I6 { float j[]; };
layout(push_constant, std430) uniform Params {
  uint mode; uint batch; uint channels; uint spatial; uint classes;
  uint ignore_index; uint padding0; uint padding1; float momentum; float eps;
} p;

uint xidx(uint n, uint ch, uint s) { return (n * p.channels + ch) * p.spatial + s; }
float mean(uint ch) {
  float v = 0.0;
  for (uint n = 0u; n < p.batch; ++n)
    for (uint s = 0u; s < p.spatial; ++s) v += a[xidx(n, ch, s)];
  return v / float(p.batch * p.spatial);
}
float variance(uint ch, float m) {
  float v = 0.0;
  for (uint n = 0u; n < p.batch; ++n)
    for (uint s = 0u; s < p.spatial; ++s) {
      float q = a[xidx(n, ch, s)] - m; v += q * q;
    }
  return v / float(p.batch * p.spatial);
}

void batch_norm_forward(uint index) {
  if (index < p.channels) {
    float m = mean(index); float v = variance(index, m); float r = 1.0 / sqrt(v + p.eps);
    g[index] = m; h[index] = r;
    d[index] = p.momentum * m + (1.0 - p.momentum) * d[index];
    e[index] = p.momentum * (v * float(p.batch * p.spatial) / float(p.batch * p.spatial - 1u)) + (1.0 - p.momentum) * e[index];
  }
  if (index < p.batch * p.channels * p.spatial) {
    uint ch = (index / p.spatial) % p.channels;
    float m = mean(ch); float v = variance(ch, m); float r = 1.0 / sqrt(v + p.eps);
    f[index] = (a[index] - m) * r * b[ch] + c[ch];
  }
}

void batch_norm_sums(uint ch, out float sum_dy, out float sum_xdy) {
  float m = f[ch]; sum_dy = 0.0; sum_xdy = 0.0;
  for (uint n = 0u; n < p.batch; ++n) for (uint s = 0u; s < p.spatial; ++s) {
    uint q = xidx(n, ch, s); float dy = a[q]; sum_dy += dy; sum_xdy += (b[q] - m) * dy;
  }
}

void batch_norm_backward(uint index) {
  if (index < p.channels) {
    float sum_dy, sum_xdy;
    batch_norm_sums(index, sum_dy, sum_xdy);
    i[index] = sum_xdy * g[index]; j[index] = sum_dy;
  }
  if (index < p.batch * p.channels * p.spatial) {
    uint ch = (index / p.spatial) % p.channels;
    float m = f[ch]; float r = g[ch]; float sum_dy, sum_xdy;
    batch_norm_sums(ch, sum_dy, sum_xdy);
    float dy = a[index]; float dx = (float(p.batch * p.spatial) * dy - sum_dy - (b[index] - m) * r * r * sum_xdy) * r * c[ch] / float(p.batch * p.spatial);
    h[index] = dx;
  }
}

// LayerNorm modes 2-6. Bindings are positional: the host binds the inputs
// first and the outputs next, so each mode names its roles below.
bool ln_isnan(float v) { return (floatBitsToUint(v) & 0x7fffffffu) > 0x7f800000u; }
float ln_nan() { return uintBitsToFloat(0x7fc00000u); }
float ln_rstd(float variance) {
  float t = variance + p.eps;
  if (ln_isnan(t) || t < 0.0) return ln_nan();
  if (t == 0.0) return uintBitsToFloat(0x7f800000u);
  if (floatBitsToUint(t) == 0x7f800000u) return 0.0;
  return 1.0 / sqrt(t);
}
bool ln_has_weight() { return (p.spatial & 1u) != 0u; }
bool ln_has_bias() { return (p.spatial & 2u) != 0u; }

// mode 2: in a=x; out b=mean, c=rstd; one invocation per row.
void layer_norm_stats(uint row) {
  if (row >= p.batch) return;
  if (p.channels == 0u) { b[row] = 0.0; c[row] = ln_nan(); return; }
  float n = float(p.channels); float sum = 0.0;
  for (uint k = 0u; k < p.channels; ++k) sum += a[row * p.channels + k];
  float m = sum / n; float v = 0.0;
  for (uint k = 0u; k < p.channels; ++k) {
    float q = a[row * p.channels + k] - m; v += q * q;
  }
  b[row] = m; c[row] = ln_rstd(v / n);
}

// mode 3: in a=x, b=mean, c=rstd, d=weight, e=bias; out f; one per element.
void layer_norm_apply(uint index) {
  if (index >= p.batch * p.channels) return;
  uint row = index / p.channels; uint col = index % p.channels;
  float y = (a[index] - b[row]) * c[row];
  if (ln_has_weight()) y *= d[col];
  if (ln_has_bias()) y += e[col];
  f[index] = y;
}

// mode 4: in a=dy, b=x, c=mean, d=rstd, e=weight; out f=sum(dy*w*x), g=sum(dy*w).
void layer_norm_backward_rows(uint row) {
  if (row >= p.batch) return;
  float ds = 0.0; float db = 0.0;
  for (uint k = 0u; k < p.channels; ++k) {
    uint q = row * p.channels + k;
    float dyw = a[q] * (ln_has_weight() ? e[k] : 1.0);
    ds += dyw * b[q]; db += dyw;
  }
  f[row] = ds; g[row] = db;
}

// mode 5: in a=dy, b=x, c=mean, d=rstd; out e=dweight, f=dbias; one per column.
void layer_norm_backward_columns(uint col) {
  if (col >= p.channels) return;
  float dw = 0.0; float db = 0.0;
  for (uint row = 0u; row < p.batch; ++row) {
    uint q = row * p.channels + col;
    dw += a[q] * (b[q] - c[row]) * d[row]; db += a[q];
  }
  e[col] = dw; f[col] = db;
}

// mode 6: in a=dy, b=x, c=mean, d=rstd, e=weight, f=ds, g=db; out h=dx.
void layer_norm_backward_input(uint index) {
  if (index >= p.batch * p.channels) return;
  uint row = index / p.channels; uint col = index % p.channels;
  float n = float(p.channels); float r = d[row]; float scale = 1.0 / n;
  float bb = (g[row] * c[row] - f[row]) * r * r * r * scale;
  float cc = -bb * c[row] - g[row] * r * scale;
  h[index] = r * a[index] * (ln_has_weight() ? e[col] : 1.0) + bb * b[index] + cc;
}

void main() {
  uint index = gl_GlobalInvocationID.x;
  if (p.mode == 0u) batch_norm_forward(index);
  else if (p.mode == 1u) batch_norm_backward(index);
  else if (p.mode == 2u) layer_norm_stats(index);
  else if (p.mode == 3u) layer_norm_apply(index);
  else if (p.mode == 4u) layer_norm_backward_rows(index);
  else if (p.mode == 5u) layer_norm_backward_columns(index);
  else if (p.mode == 6u) layer_norm_backward_input(index);
}
