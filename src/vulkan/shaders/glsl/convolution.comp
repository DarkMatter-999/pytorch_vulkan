#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0) readonly buffer Input { float input_values[]; };
layout(set = 0, binding = 1) readonly buffer Weight { float weight_values[]; };
layout(set = 0, binding = 2) readonly buffer Bias { float bias_values[]; };
layout(set = 0, binding = 3) writeonly buffer Output { float output_values[]; };
layout(push_constant) uniform Params {
  uint batch;
  uint input_channels;
  uint input_height;
  uint input_width;
  uint output_channels;
  uint output_height;
  uint output_width;
  uint kernel_height;
  uint kernel_width;
  uint operation;
}
params;
uint ii(uint n, uint c, uint h, uint w) {
  return ((n * params.input_channels + c) * params.input_height + h) * params.input_width + w;
}
uint oi(uint n, uint c, uint h, uint w) {
  return ((n * params.output_channels + c) * params.output_height + h) * params.output_width + w;
}
uint wi(uint oc, uint ic, uint kh, uint kw) {
  return ((oc * params.input_channels + ic) * params.kernel_height + kh) * params.kernel_width + kw;
}
void main() {
  uint index = gl_GlobalInvocationID.x;
  if (params.operation == 0u) {
    uint count = params.batch * params.output_channels * params.output_height * params.output_width;
    if (index >= count)
      return;
    uint ow = index % params.output_width;
    uint oh = (index / params.output_width) % params.output_height;
    uint oc = (index / (params.output_width * params.output_height)) % params.output_channels;
    uint n = index / (params.output_width * params.output_height * params.output_channels);
    float value = bias_values[oc];
    for (uint ic = 0u; ic < params.input_channels; ++ic)
      for (uint kh = 0u; kh < params.kernel_height; ++kh)
        for (uint kw = 0u; kw < params.kernel_width; ++kw) {
          int ih = int(oh) + int(kh) - 1;
          int iw = int(ow) + int(kw) - 1;
          if (ih >= 0 && ih < int(params.input_height) && iw >= 0 && iw < int(params.input_width))
            value +=
                input_values[ii(n, ic, uint(ih), uint(iw))] * weight_values[wi(oc, ic, kh, kw)];
        }
    output_values[index] = value;
  } else if (params.operation == 1u) {
    uint count = params.batch * params.input_channels * params.input_height * params.input_width;
    if (index >= count)
      return;
    uint iwv = index % params.input_width;
    uint ih = (index / params.input_width) % params.input_height;
    uint ic = (index / (params.input_width * params.input_height)) % params.input_channels;
    uint n = index / (params.input_width * params.input_height * params.input_channels);
    float value = 0.0;
    for (uint oc = 0u; oc < params.output_channels; ++oc)
      for (uint kh = 0u; kh < params.kernel_height; ++kh)
        for (uint kw = 0u; kw < params.kernel_width; ++kw) {
          int oh = int(ih) - int(kh) + 1;
          int ow = int(iwv) - int(kw) + 1;
          if (oh >= 0 && oh < int(params.output_height) && ow >= 0 && ow < int(params.output_width))
            value +=
                input_values[oi(n, oc, uint(oh), uint(ow))] * weight_values[wi(oc, ic, kh, kw)];
        }
    output_values[index] = value;
  } else if (params.operation == 2u) {
    uint count =
        params.output_channels * params.input_channels * params.kernel_height * params.kernel_width;
    if (index >= count)
      return;
    uint kw = index % params.kernel_width;
    uint kh = (index / params.kernel_width) % params.kernel_height;
    uint ic = (index / (params.kernel_width * params.kernel_height)) % params.input_channels;
    uint oc = index / (params.kernel_width * params.kernel_height * params.input_channels);
    float value = 0.0;
    for (uint n = 0u; n < params.batch; ++n)
      for (uint oh = 0u; oh < params.output_height; ++oh)
        for (uint ow = 0u; ow < params.output_width; ++ow) {
          int ih = int(oh) + int(kh) - 1;
          int iw = int(ow) + int(kw) - 1;
          if (ih >= 0 && ih < int(params.input_height) && iw >= 0 && iw < int(params.input_width))
            value += input_values[oi(n, oc, oh, ow)] * weight_values[ii(n, ic, uint(ih), uint(iw))];
        }
    output_values[index] = value;
  } else {
    if (index >= params.output_channels)
      return;
    float value = 0.0;
    for (uint n = 0u; n < params.batch; ++n)
      for (uint oh = 0u; oh < params.output_height; ++oh)
        for (uint ow = 0u; ow < params.output_width; ++ow)
          value += input_values[oi(n, index, oh, ow)];
    output_values[index] = value;
  }
}
